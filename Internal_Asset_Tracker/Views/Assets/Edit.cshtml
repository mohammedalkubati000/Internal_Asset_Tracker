@model Asset

@{
    ViewData["Title"] = "Edit";
}
<div class="container">
    <h1>Edit Asset </h1>
     
    <form asp-action="Edit" method="post" >
        <input type="hidden" asp-for="Id" />
    <div class="text-danger" asp-validation-summary="All">
    </div>

    <div class="form-group">
        <label asp-for="Name" class="control-label"></label>
        <input asp-for="Name" class="form-control" />
        <span class="text-danger" asp-validation-for="Name"></span>

    </div>

    <div class="form-group">
        <label asp-for="SerialNumber" class="control-label"></label>
        <input asp-for="SerialNumber" class="form-control" />
        <span class="text-danger" asp-validation-for="SerialNumber"></span>

    </div>

    <div class="form-group">
        <label asp-for="Category" class="control-label"></label>
        <input asp-for="Category" class="form-control" />
        <span class="text-danger" asp-validation-for="Category"></span>

    </div>

    <div class="form-group">
        <label asp-for="Status" class="control-label"></label>
        <input asp-for="Status" class="form-control" />
        <span class="text-danger" asp-validation-for="Status"></span>

    </div>
            
            
    <div class="form-group">
        <input type="submit" value="Update" class="btn btn-warning" />
    </div>
        </form>
    <div>
        <a asp-action="Index">Back to List</a>
    </div>
</div>


@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
