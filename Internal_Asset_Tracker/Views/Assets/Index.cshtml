@model IEnumerable<Asset>

@{
    ViewData["Title"] = "Index";
}

<div class="container mt-4">
<div class="text-end">
    <a asp-action="Create" class="btn btn-primary"> New Asset </a>
</div>
<h1>Index</h1>

<table class="table table-striped">
    <thead>
        <tr>
            <th>Name</th>
            <th>SerialNumber</th>
            <th>Category</th>
            <th>Status</th>
            <th>Actions</th>
        </tr>
    </thead>

    <tbody>
        @foreach (var emp in Model)
        {

        <tr>
            
                <td>@emp.Name</td>
                <td>@emp.SerialNumber</td>
                <td>@emp.Category</td>
                <td>@emp.Status</td>

          
                    <td>
                        <!--
                        <a asp-action="Edit" asp-route-id="@emp.Id">Edit</a> | |
                        <a asp-action="Delete" asp-route-id="@emp.Id">Delete</a>
                        -->
                        <a asp-action="Edit" asp-route-uuid="@emp.Id" class="btn btn-warning"> Edit  </a>
                        <a asp-action="Delete" asp-route-uuid="@emp.Id" class="btn btn-danger"> Delete  </a>
            </td>
        </tr>
}
    </tbody>
</table>
