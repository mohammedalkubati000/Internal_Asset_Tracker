    @model Asset

    @{
        ViewData["Title"] = "Delete";
    }


    <div class="container">
        <h1>Delete Asset</h1>

        <div class="form-group">
            <label asp-for="Name" class="control-label"></label>
            <input asp-for="Name" class="form-control" readonly />
        </div>
        <div class="form-group">
            <label asp-for="SerialNumber" class="control-label"></label>
            <textarea asp-for="SerialNumber" class="form-control" readonly></textarea>
        </div>
        <div class="form-group">
            <label asp-for="Category" class="control-label"></label>
            <textarea asp-for="Category" class="form-control" readonly></textarea>
        </div>
        <div class="form-group">
            <label asp-for="Status" class="control-label"></label>
            <textarea asp-for="Status" class="form-control" readonly></textarea>
        </div>

        

        <form asp-action="Delete" method="post">
        <input type="hidden" asp-for="Id" />
            <div class="form-group">
                <input type="submit" value="Delete" class="btn btn-danger" />
            </div>
        </form>
        <div>
            <a asp-action="Index">Back to List</a>
        </div>
    </div>
