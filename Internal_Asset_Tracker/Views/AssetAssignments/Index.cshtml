@model IEnumerable<AssetAssignment>

@{
    ViewData["Title"] = "Asset Assignments";
}

<div class="container mt-4">
<div class="text-end">
        <a asp-action="Create" class="btn btn-primary"> New Asset Assignments </a>
</div>
<h1>Index</h1>

<table class="table table-striped">
    <thead>
        <tr>
                <th>Id</th>
                <th>Asset</th>
                <th>Employee</th>
                <th>Assigned Date</th>
                <th>Return Date</th>
                <th>IsActive</th>
            <th>Actions</th>
        </tr>
    </thead>

    <tbody>
            @foreach (var emp in Model)
            {

                <tr>
                    <td>@emp.Id</td>
                    <td>@emp.Asset?.Name</td>
                    <td>@emp.Employee?.FullName</td>
                    <td>@emp.AssignedDate</td>
                    <td>@emp.ReturnDate</td>
                    <td>@emp.IsActive</td>


                    <td>
                        <!--
                        <a asp-action="Edit" asp-route-id="@emp.Id">Edit</a> | |
                        <a asp-action="Delete" asp-route-id="@emp.Id">Delete</a>
                        -->
                        <a asp-action="Edit" asp-route-id="@emp.Id" class="btn btn-warning"> Edit  </a>
                        <a asp-action="Delete" asp-route-id="@emp.Id" class="btn btn-danger"> Delete  </a>
                    </td>
                </tr>
            
            }
    </tbody>
</table>
