@model AssetAssignment
@{
    ViewData["Title"] = "Edit "; 
}

<div class="container">
    <h1>Edit Asset </h1>

    <form asp-action="Edit" method="post">
        <input type="hidden" asp-for="Id" />
        <div class="text-danger" asp-validation-summary="All">
        </div>

        <div class="form-group">
            <label asp-for="Id" class="control-label"></label>
            <input asp-for="Id" class="form-control" />
            <span class="text-danger" asp-validation-for="Id"></span>

        </div>

        <div class="form-group">
            <label asp-for="Asset" class="control-label"></label>
            <input asp-for="Asset" class="form-control" />
            <span class="text-danger" asp-validation-for="Asset"></span>

        </div>

        <div class="form-group">
            <label asp-for="Employee" class="control-label"></label>
            <input asp-for="Employee" class="form-control" />
            <span class="text-danger" asp-validation-for="Employee"></span>

        </div>

        <div class="form-group">
            <label asp-for="AssignedDate" class="control-label"></label>
            <input asp-for="AssignedDate" class="form-control" />
            <span class="text-danger" asp-validation-for="AssignedDate"></span>

        </div>
        <div class="form-group">
            <label asp-for="ReturnDate" class="control-label"></label>
            <input asp-for="ReturnDate" class="form-control" />
            <span class="text-danger" asp-validation-for="ReturnDate"></span>

        </div>
        <div class="form-group">
            <label asp-for="IsActive" class="control-label"></label>
            <input asp-for="IsActive" class="form-control" />
            <span class="text-danger" asp-validation-for="IsActive"></span>

        </div>
            
        <div class="form-group">
            <input type="submit" value="Update" class="btn btn-warning" />
        </div>
    </form>
    <div>
        <a asp-action="Index">Back to List</a>
    </div>
</div>


@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
