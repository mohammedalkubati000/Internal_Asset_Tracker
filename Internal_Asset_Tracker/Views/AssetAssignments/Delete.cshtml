@model AssetAssignment
@{
    ViewData["Title"] = "Delete";
}



<div class="container">
    <h1>Delete Asset</h1>
    <div class="form-group">
        <label asp-for="Id" class="control-label"></label>
        <input asp-for="Id" class="form-control" readonly />
    </div>
    <div class="form-group">
        <label asp-for="Asset" class="control-label"></label>
        <input asp-for="Asset" class="form-control" readonly />
    </div>
    <div class="form-group">
        <label asp-for="Employee" class="control-label"></label>
        <input asp-for="Employee" class="form-control" readonly />
    </div>
    <div class="form-group">
        <label asp-for="AssignedDate" class="control-label"></label>
        <textarea asp-for="AssignedDate" class="form-control" readonly></textarea>
    </div>
    <div class="form-group">
        <label asp-for="ReturnDate" class="control-label"></label>
        <textarea asp-for="ReturnDate" class="form-control" readonly></textarea>
    </div>
    <div class="form-group">
        <label asp-for="IsActive" class="control-label"></label>
        <textarea asp-for="IsActive" class="form-control" readonly></textarea>
    </div>

        

    <form asp-action="Delete" method="post">
        <input type="hidden" asp-for="Id" />
        <div class="form-group">
            <input type="submit" value="Delete" class="btn btn-danger" />
        </div>
    </form>
    <div>
        <a asp-action="Index">Back to List</a>
    </div>
</div>